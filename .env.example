# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# --- Postgres / PostGIS ---
POSTGRES_USER=sdm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sdm
SDM_DATABASE_URL=postgresql+psycopg2://sdm:change-me@postgres:5432/sdm

# --- Redis / Celery ---
SDM_REDIS_URL=redis://redis:6379/0

# --- GBIF (required for DOI-backed occurrence downloads on first-time species) ---
SDM_GBIF_USER=
SDM_GBIF_PWD=
SDM_GBIF_EMAIL=

# --- Global bioclim layer (immutable, versioned; see backend/src/features/bioclim_store.py) ---
SDM_BIOCLIM_VERSION=bioclim_v1

# --- DVC remote (S3-compatible, versions data/bioclim/*; `docker compose --profile dvc`) ---
# Generate random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
SDM_DVC_ACCESS_KEY=
SDM_DVC_SECRET_KEY=
SDM_DVC_BUCKET=sdm-dvc
SDM_DVC_PORT=7070

# --- Modeling / housekeeping ---
# Seed for thinning, background sampling and CV folds (logged with every model version).
SDM_RANDOM_SEED=42
# Background (pseudo-absence) sampling: target_group (GBIF sampling effort of the species'
# order; falls back to buffer when sparse or unreachable) or buffer. Changes model results.
SDM_BACKGROUND_METHOD=target_group
SDM_TARGET_GROUP_RANK=order
# How target-group cells are drawn: unique_cells (each once), record_count (bias file) or
# sqrt_record_count. Changes model results.
SDM_TARGET_GROUP_WEIGHTING=unique_cells
# B1: restrict target-group effort to the presences' basis of record / 5–95 % year window.
SDM_TARGET_GROUP_MATCH_SOURCE=false
SDM_TARGET_GROUP_MATCH_YEARS=false
# Thinning: distance (fixed SDM_THIN_KM) | autocorrelation (B3: variogram range, clamped to
# [SDM_THIN_KM, SDM_THIN_MAX_KM]) | environmental (B4: one record per environmental bin).
# SDM_THIN_REPS > 1 = maximal-retention thinning (spThin). Changes model results.
SDM_THIN_METHOD=distance
SDM_THIN_KM=10
SDM_THIN_REPS=1
SDM_THIN_MAX_KM=50
SDM_ENV_THIN_BINS=20
# Global target-group effort raster per model version (~32 GBIF map-tile requests per run).
SDM_EFFORT_LAYER_ENABLED=true
# Sampling-bias handling (off by default; changes model results, logged per version):
# presence weights none | quality_tier | density | quality_tier_density, and the
# target-group effort bias covariate none | target_group_effort (held at max | p95).
SDM_PRESENCE_WEIGHTING=none
SDM_BIAS_COVARIATE=none
SDM_BIAS_CONDITION=max
# Static bias rasters registered with `bioclim_store add-bias-layer` (e.g. ["travel_time"]).
SDM_BIAS_STATIC_LAYERS=[]
# Threshold for the binary zones: p10 | max_tss | equal_sens_spec | min_training_presence |
# fixed (with SDM_THRESHOLD_VALUE). Every rule is computed and logged per version.
SDM_THRESHOLD_RULE=p10
# Algorithm: maxent | ensemble (MaxEnt + GLM/GAM/RF/BRT) | integrated (experimental; needs
# training uploads with absences — docs/adr/0002-integrated-sdm.md).
SDM_ALGORITHM=maxent
# ppm (experimental): offset (log effort, coefficient 1) | estimated | shared (target group's
# joint estimate from POST /species/{key}/shared-bias; needs ≥ SDM_SHARED_BIAS_MIN_SPECIES).
SDM_PPM_BIAS=offset
SDM_SHARED_BIAS_MIN_SPECIES=3
SDM_ENSEMBLE_MEMBERS=["maxent","glm","gam","rf","brt"]
# Pseudo-absences of the ensemble's presence–absence members:
# background | disk | environmental_profile | completeness
SDM_PSEUDO_ABSENCE_STRATEGY=disk
SDM_N_PSEUDO_ABSENCES=5000
SDM_PA_MIN_DISTANCE_KM=50
# A target-group effort pixel with at least this many records counts as well surveyed.
SDM_COMPLETENESS_MIN_RECORDS=50
SDM_LIMITING_FACTOR_ENABLED=true
SDM_INFERRED_ABSENCE_CHECK=true
SDM_PRIORITY_LAYER_ENABLED=true
# Data-quality tests: reference gazetteer version (python -m src.features.quality_refs build),
# tests whose flags exclude records (JSON list; unset = every "error" test) and the first
# year of the climate baseline. Changes model results; all are logged per version.
SDM_QUALITY_REFERENCE_VERSION=quality_refs_v1
# SDM_QUALITY_EXCLUDE=["equal_coordinates","gbif_headquarters","capital","country_centroid","province_centroid","institution","gbif_geospatial_issue","low_precision","duplicate_specimen"]
SDM_QUALITY_BASELINE_START_YEAR=1970
# Independent (evaluation-only) data: explicit GBIF absences, upload limits, and when an
# uploaded record counts as a duplicate of a GBIF/iNaturalist record.
SDM_GBIF_ABSENCES_ENABLED=true
SDM_UPLOAD_MAX_BYTES=26214400
SDM_UPLOAD_MAX_ROWS=200000
SDM_OVERLAP_DISTANCE_M=100
SDM_OVERLAP_MAX_DAYS=1
# Independent climate stack for the climate-data cross-check (bioclim_store build-chelsa).
SDM_CROSSCHECK_BIOCLIM_VERSION=
# Largest region (cells) for one high-resolution projection (bioclim_store add-hires).
SDM_HIRES_MAX_CELLS=16000000
# Archive feature tables of species not requested for this many days (0 disables).
SDM_ARCHIVE_INACTIVE_AFTER_DAYS=180

# --- Species lists / batch runs (U9) ---
SDM_BATCH_MAX_SPECIES=200
SDM_LIST_MAX_NAMES=200

# --- Early-detection alerts ---
SDM_ALERTS_ENABLED=true
SDM_ALERT_KNOWN_RANGE_KM=100
# Webhooks must be https to public hosts; list internal hosts here to allow them.
# SDM_ALERT_WEBHOOK_ALLOWED_HOSTS=["hooks.internal"]
SDM_SMTP_HOST=
SDM_SMTP_PORT=587
SDM_SMTP_USER=
SDM_SMTP_PASSWORD=
SDM_SMTP_FROM=rangewatch@localhost
SDM_API_PUBLIC_URL=http://localhost:8080/api
# Proposed effort-aware retrain trigger (pending review, docs/adr/0001): envelope | effort_aware
SDM_RETRAIN_TRIGGER_MODE=envelope
SDM_EFFORT_SAMPLED_MIN_RECORDS=10

# --- Users and roles (viewer < analyst < curator) ---
# none: single user, everyone is a curator. header: an identity-aware proxy (oauth2-proxy, …)
# sets the user/groups headers; it must strip them from client requests.
SDM_AUTH_MODE=none
SDM_AUTH_USER_HEADER=X-Auth-Request-User
SDM_AUTH_GROUPS_HEADER=X-Auth-Request-Groups
SDM_AUTH_ROLE_GROUPS={"rangewatch-curators":"curator","rangewatch-analysts":"analyst"}
SDM_AUTH_DEFAULT_ROLE=viewer

# --- MLflow ---
SDM_MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Gateway (the only public port) ---
SDM_GATEWAY_PORT=8080
# Set both to require HTTP Basic auth for the dashboard, API and tiles (leave empty locally).
SDM_AUTH_USER=
SDM_AUTH_PASSWORD=

# --- Tile URLs handed to the browser (same-origin paths routed by the gateway) ---
SDM_TITILER_PUBLIC_URL=/tiles/raster
SDM_TILESERV_PUBLIC_URL=/tiles/vector
SDM_CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (build-time; public values only, never secrets) ---
VITE_API_BASE_URL=/api
VITE_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
