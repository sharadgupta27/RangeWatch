<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>RangeWatch bulletin — {{ species.scientific_name }} (v{{ mv.model_version }})</title>
<link rel="stylesheet" href="bulletin.css">
</head>
<body>

<!-- 1. Header -->
<header class="masthead">
  <div class="masthead-text">
    <p class="kicker">RangeWatch · Species distribution bulletin</p>
    <h1><em>{{ species.scientific_name }}</em></h1>
    {% if species.common_name %}<p class="common">{{ species.common_name }}</p>{% endif %}
    <p class="meta">
      GBIF taxon key {{ species.taxon_key }} · Model v{{ mv.model_version }}
      ({{ "Model B — native + invaded" if mv.model_type == "B" else "Model A — native only" }})
      · Generated {{ generated }}
    </p>
    <p class="meta">Occurrence data: {{ repro.gbif_citation }}</p>
    {% if repro.inat_citation %}<p class="meta">Supplementary data: {{ repro.inat_citation }}</p>{% endif %}
  </div>
  {% if species.thumbnail_url %}
  <img class="thumb" src="{{ species.thumbnail_url }}" alt="">
  {% endif %}
</header>

{% if mv.model_type == "A" %}
<div class="banner warn">
  <strong>Lower-confidence projection.</strong> No documented introduced-range records were
  available, so this model was trained on native-range data only (Model A).
</div>
{% endif %}

<!-- 2. Executive summary -->
<section>
  <h2>Executive summary</h2>
  <p class="lead">{{ summary }}</p>
  <div class="caveat"><strong>Transferability caveat.</strong> {{ caveat }}</div>
</section>

<!-- 3. Map panel 1 -->
<section class="figure">
  <h2>Native range and suitability</h2>
  <img src="{{ figures.native_map }}" alt="Native-range occurrence map">
  <p class="caption">Occurrences by effective range label over continuous suitability; white
    contour = binarisation threshold ({{ m.threshold | num(3) }}, {{ m.threshold_rule }});
    dashed line = native-range polygon, {{ native_status }}.</p>
</section>

<!-- 4. Map panel 2 -->
<section class="figure">
  <h2>Global projection, candidate invasion zones and extrapolation</h2>
  <img src="{{ figures.global_map }}" alt="Global projection map">
  <p class="caption">Hatched cells have MESS &lt; 0: at least one predictor lies outside the
    training range, so suitability there is an extrapolation and should be treated with low
    confidence. {{ m.projection.extrapolation_area_km2 | num }} km² of land is extrapolated.</p>
</section>

{% if extrapolation %}
<!-- 4b. Advanced extrapolation diagnostics -->
<section class="figure">
  <h2>Extrapolation diagnostics</h2>
  {% if figures.consensus_map %}<img src="{{ figures.consensus_map }}" alt="Extrapolation consensus map">{% endif %}
  <p class="caption">Number of the five diagnostics that flag each land cell as extrapolation.
    They test different things: MESS and exDet NT1 check predictor ranges, exDet NT2 detects
    novel combinations of in-range values, MOP and Shape measure distance to the closest
    analogous training conditions, and AOA measures distance in the importance-weighted
    predictor space the model relies on. Where several agree, suitability is least reliable.
    {{ (extrapolation.candidate_consensus_ok_fraction * 100) | num }}% of the candidate zone is
    flagged by none and {{ (extrapolation.candidate_consensus_majority_fraction * 100) | num }}%
    by at least three.</p>
  <table class="compact">
    <tr><th>Diagnostic</th><th>Flags extrapolation when</th><th>Threshold</th>
        <th>Land flagged</th><th>Candidate zone flagged</th></tr>
    {% for d in extrapolation.diagnostics %}
    <tr><td>{{ d.label }} <span class="small">({{ d.reference }})</span></td>
        <td>{{ d.flag_rule }}</td>
        <td>{{ d.threshold | num(3) }}</td>
        <td>{{ (d.land_fraction * 100) | num(1) }}%</td>
        <td>{{ (d.candidate_flagged_fraction * 100) | num(1) }}%</td></tr>
    {% endfor %}
  </table>
  <p class="small">Reference set: {{ extrapolation.reference_set }}
    (n = {{ extrapolation.n_reference | num }}). exDet uses its published cut-offs (NT1 &lt; 0,
    NT2 &gt; 1). MOP (mean distance to the closest {{ extrapolation.mop_percentage }}% of
    reference points, z-scored), Shape and AOA (importance-weighted) thresholds are the
    outlier-trimmed maximum, min(Q75 + 1.5·IQR, max), of the training points' values against
    the other {{ extrapolation.n_cv_folds - 1 }} spatial CV folds (Meyer &amp; Pebesma 2021).
    {% if extrapolation.combinatorial %}Novel combinations (exDet NT2 &gt; 1,
    {{ extrapolation.exdet_combinatorial_area_km2 | num }} km²) are driven mainly by
    {% for d in extrapolation.combinatorial %}{{ d.name }}{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
</section>
{% endif %}

<div class="two-col">
  <!-- 5. Severity gauge -->
  <section>
    <h2>Severity index</h2>
    {% if figures.gauge %}<img src="{{ figures.gauge }}" alt="Severity gauge">{% endif %}
    <table class="compact">
      <tr><th>Component</th><th>S</th><th>w</th><th>w·S</th></tr>
      {# fixed order: jsonb does not preserve key order #}
      {% for k in severity_components %}{% set v = sev.components[k] %}
      <tr><td>{{ k.replace('_', ' ') }}</td><td>{{ v | num(2) }}</td>
          <td>{{ sev.weights[k] | num(2) }}</td><td>{{ sev.contributions[k] | num(3) }}</td></tr>
      {% endfor %}
      <tr class="total"><td>Severity</td><td></td><td></td><td>{{ sev.score | num(3) }}</td></tr>
    </table>
    <p class="small">Confidence: <strong>{{ sev.confidence.level }}</strong>
      ({% if sev.confidence.basis == "consensus" %}{{ (sev.confidence.consensus_majority_fraction * 100) | num }}%
      of candidate area flagged by ≥ 3 of 5 extrapolation diagnostics,
      {{ (sev.confidence.consensus_ok_fraction * 100) | num }}% by none; {% endif %}{{ (sev.confidence.mess_ok_fraction * 100) | num }}%
      with MESS ≥ 0. {{ sev.confidence.note }})
      {% if sev.confidence.reasons %}Lowered by: {{ sev.confidence.reasons | join('; ') }}.{% endif %}</p>
  </section>

  <!-- 6. Variable importance -->
  <section>
    <h2>Variable importance</h2>
    <img src="{{ figures.importance }}" alt="Variable importance">
    <ul class="small">
      {% for p in m.predictors %}<li>{{ p.upper() }} — {{ bioclim_names[p] }}</li>{% endfor %}
    </ul>
  </section>
</div>

<!-- 7. Diagnostics -->
<section>
  <h2>Model diagnostics</h2>
  <table>
    <tr><th>Metric</th><th>Value</th><th>Metric</th><th>Value</th></tr>
    <tr><td>AUC (spatial CV)</td><td>{{ m.auc_mean | num(3) }} ± {{ m.auc_std | num(3) }}</td>
        <td>n presences (thinned)</td><td>{{ m.n_presence | num }}</td></tr>
    <tr><td>CBI (spatial CV)</td><td>{{ m.cbi_mean | num(3) }} ± {{ m.cbi_std | num(3) }}</td>
        <td>n background</td><td>{{ m.n_background | num }} ({{ m.background_method }})</td></tr>
    <tr><td>TSS (spatial CV)</td><td>{{ m.tss_mean | num(3) }} ± {{ m.tss_std | num(3) }}</td>
        <td>CV folds</td><td>{{ m.n_cv_folds }} — {{ m.cv_method }}</td></tr>
    <tr><td>Training AUC</td><td>{{ m.train_auc | num(3) }}</td>
        <td>Features / regularisation</td><td>{{ m.feature_classes }} / β = {{ m.beta_multiplier }}</td></tr>
  </table>
  {% if independent %}
  <h3>Independent evaluation</h3>
  <p class="meta">Records this model never saw: uploaded surveys (records duplicating a
    GBIF/iNaturalist record are left out) and absences reported to GBIF. Sensitivity = share of
    presences predicted suitable at the model threshold; analog / extrapolated splits it by
    MESS ≥ 0 / &lt; 0.</p>
  <table class="compact">
    <tr><th>Dataset</th><th>Presences</th><th>Sensitivity</th><th>Analog / extrapolated</th>
        <th>CBI</th><th>Absences</th><th>Specificity</th><th>AUC</th></tr>
    {% for e in independent %}{% set x = e.metrics %}
    <tr><td>{{ e.name }}</td><td>{{ x.n_presence | num }}</td><td>{{ x.sensitivity | pct }}</td>
        <td>{{ x.sensitivity_analog | pct }} / {{ x.sensitivity_extrapolated | pct }}</td>
        <td>{{ x.cbi | num(2) }}</td><td>{{ x.n_absence | num }}</td>
        <td>{{ x.specificity | pct }}</td><td>{{ x.auc_presence_absence | num(2) }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

<!-- 8. Expansion outlook -->
<section>
  <h2>Expansion outlook</h2>
  <img src="{{ figures.timeline }}" alt="Records per year">
  <p>{{ outlook.trend }}
    {% if outlook.spread_rate is not none %}Newly occupied 1° cells outside the native range:
    {{ outlook.spread_rate | num(1) }} per year.{% endif %}</p>
  {% if outlook.regions %}
  <p><strong>Largest candidate invasion zones (10° tiles):</strong>
    {% for r in outlook.regions %}{{ r.tile }} ({{ r.area_km2 | num }} km²){% if not loop.last %}; {% endif %}{% endfor %}.</p>
  {% endif %}
  {% if outlook.limiting %}
  <p><strong>Main sources of extrapolation (MESS most-dissimilar variable):</strong>
    {% for d in outlook.limiting %}{{ d.name }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% endif %}
  <div class="caveat">{{ caveat }}</div>
</section>

<!-- 9. Methods & references -->
<section class="methods">
  <h2>Methods &amp; reproducibility</h2>
  <p>Presence-background MaxEnt (elapid {{ repro.package_versions.elapid }}) with feature
    classes and regularisation selected from the Wallace/ENMeval default grid by spatially
    block-cross-validated CBI. Occurrences were cleaned, de-duplicated to one per raster cell
    {% set th = repro.thinning %}
    {% if th and th.method == 'environmental' %}
    environmentally thinned to one record per cell of a {{ th.n_bins }}-bin grid on the first
    {{ th.n_axes }} principal axes of the predictors (Varela et al. 2014; {{ th.n_before | num }}
    → {{ th.n_after | num }} presences);
    {% elif th and th.method == 'autocorrelation' %}
    distance-thinned at {{ th.distance_km }} km, the spatial autocorrelation range of the
    predictors (median variogram range{% if th.autocorrelation %} {{ th.autocorrelation.range_km }} km,
    clamped to {{ th.autocorrelation.clamped_to_km | join('–') }} km{% endif %}; Valavi et al. 2019){% if th.reps and th.reps > 1 %},
    best of {{ th.reps }} passes (spThin){% endif %};
    {% else %}
    and distance-thinned ({{ th.distance_km if th else repro.training_config.thin_km }} km{% if th and th.reps and th.reps > 1 %}, best of {{ th.reps }} passes (spThin){% endif %});
    {% endif %}
    {% set bgi = repro.background %}
    {% if bgi and bgi.target_group and not bgi.fallback_reason %}
    background points were drawn from raster cells holding GBIF records of the target group
    ({{ bgi.target_group.rank }} {{ bgi.target_group.name }},
    {{ bgi.target_group.n_records | num }} records) within a
    {{ repro.training_config.background_buffer_km | num }} km buffer of presences, so that the
    background shares the observer bias of the presences (target-group background).
    {% else %}
    background points were sampled uniformly within a
    {{ repro.training_config.background_buffer_km | num }} km buffer of presences{% if bgi and bgi.fallback_reason %}
    (target-group background not used: {{ bgi.fallback_reason }}){% endif %}.
    {% endif %}
    {% if bgi and bgi.target_group and bgi.target_group.weighting and bgi.target_group.weighting != 'unique_cells' %}
    Target-group cells were drawn with probability proportional to
    {{ 'the square root of ' if bgi.target_group.weighting == 'sqrt_record_count' else '' }}their
    record count (bias file).
    {% endif %}
    {% set pw = repro.presence_weights %}
    {% if pw and pw.method != 'none' %}
    Presences were weighted ({{ pw.method | replace('_', ' ') }}; rescaled to mean 1, range
    {{ pw.min }}–{{ pw.max }}) so that heavily recorded clusters and lower-quality records count
    less.
    {% endif %}
    {% set bc = repro.bias_covariates %}
    {% if bc and bc.status == 'used' %}
    Observer bias was modelled explicitly: target-group GBIF effort ({{ bc.transform }}) was a
    model covariate, held at its {{ bc.condition }} ({{ bc.conditioning_value }}) for every
    prediction, so the maps show suitability as if sampled everywhere at that effort
    (Warton et al. 2013).
    {% elif bc and bc.status == 'unavailable' %}
    The requested effort bias covariate was not used ({{ bc.reason }}).
    {% endif %}
    {% if bc and bc.static_layers %}
    {% for s in bc.static_layers if s.status == 'used' %}{% if loop.first %}Static observer-bias layers were model covariates held at their most-sampled end:
    {% endif %}{{ s.name | replace('_', ' ') }} ({{ s.direction }} effort, {{ s.transform }}, held at {{ s.conditioning_value }}{% if s.citation %}; {{ s.citation }}{% endif %}){% if not loop.last %}; {% else %}.{% endif %}{% endfor %}
    {% endif %}
    {% set matched = (bgi.target_group.matched if bgi and bgi.target_group else none) or (bc.target_group.matched if bc and bc.target_group else none) %}
    {% if matched %}
    Target-group effort was restricted to the presences' data sources / years
    ({{ matched.basis_of_record | join(', ') if matched.basis_of_record else 'all sources' }}{% if matched.years %}, {{ matched.years | join('–') }}{% endif %}; Phillips et al. 2009).
    {% endif %}
    {% if repro.training_uploads %}
    Uploaded training data:
    {% for u in repro.training_uploads %}{% if u.used_as == 'survey' %}{{ u.name }} (presence–absence survey: {{ u.n_survey_presences | num }} presences, {{ u.n_survey_absences | num }} absences){% else %}{{ u.name }} ({{ u.n_added | num }} presences{% if u.n_overlap_excluded %}, {{ u.n_overlap_excluded | num }} duplicates of GBIF/iNaturalist records left out{% endif %}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.
    {% endif %}
    {% set algo = repro.algorithm %}
    {% if m.algorithm == 'ensemble' and m.ensemble %}
    Algorithm: CV-weighted ensemble ({{ m.ensemble.weighting }}) of
    {% for e in m.ensemble.members %}{{ e.label }}{% if e.included %} (weight {{ e.weight | num(2) }}, CV AUC {{ e.auc_mean | num(2) }}){% else %} (left out){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.
    {% set pa = repro.pseudo_absences %}
    {% if pa %}Presence–absence members used {{ pa.n | num }} pseudo-absences ({{ pa.method }}{% if pa.fallback_reason %}; {{ pa.fallback_reason }}{% endif %}; Barbet-Massin et al. 2012).{% endif %}
    The ensemble-agreement layer shows where the members disagree.
    {% elif m.algorithm == 'integrated' and m.integrated %}
    Algorithm: integrated SDM (experimental) — presence-only records as a Poisson point process
    and survey records as presence–absence data sharing one climate response
    ({{ m.integrated.n_pa_present | num }} survey presences, {{ m.integrated.n_pa_absent | num }}
    survey absences); observer bias estimated{% if m.integrated.bias_coefficients %}
    (effort coefficient {% for k, v in m.integrated.bias_coefficients.items() %}{{ v | num(2) }}{% endfor %}){% endif %}
    and dropped for prediction (Fithian et al. 2015; Isaac et al. 2020).
    {% elif m.algorithm == 'ppm' and m.point_process %}
    {% set pp = m.point_process %}
    Algorithm: Poisson point process (experimental) with uniform quadrature and bias mode
    {{ pp.bias_mode }} — offset {{ pp.offset }}, dropped for prediction (constant effort;
    Renner et al. 2015{% if pp.bias_mode == 'shared' %}; bias coefficients shared by the target
    group's tracked species, Fithian et al. 2015{% endif %}).
    {% if pp.offset_test %}Likelihood-ratio test of the offset coefficient: estimated
    {{ pp.offset_test.free_coefficient | num(2) }} vs assumed {{ pp.offset_test.assumed_coefficient | num(2) }}
    (p = {{ pp.offset_test.p_value | num(3) }}): {{ pp.offset_test.interpretation }}.{% endif %}
    {% endif %}
    {% if algo and algo.fallback_reason %}Requested algorithm {{ algo.requested }} not used: {{ algo.fallback_reason }}.{% endif %}
    {% set ann = repro.annotations %}
    {% if ann and ann.n_records_annotated %}
    Expert annotations ({{ ann.n_records_annotated | num }} records): {{ ann.n_excluded_by_annotation | num }}
    left out (suspicious or cultivated), {{ ann.n_kept_verified | num }} kept despite a quality
    flag, {{ ann.n_label_overrides | num }} range labels overridden.
    {% endif %}
    {% if repro.study_region %}
    Regional model: trained and projected inside {{ repro.study_region.bbox | join(', ') }}
    (W, S, E, N) at {{ repro.study_region.resolution }}; {{ repro.study_region.n_records_outside | num }}
    records outside the region were not used.
    {% endif %}
    {% if m.thresholds %}
    Binary maps use the {{ m.threshold_rule }} threshold; alternatives (max TSS, sensitivity =
    specificity, minimum training presence) are listed with the model version.
    {% endif %}
    {% set ia = m.inferred_absences %}
    {% if ia and ia.status == 'evaluated' %}
    On {{ ia.n | num }} inferred absences (well-surveyed native-range cells without the species)
    specificity was {{ ia.specificity | num(2) }}.
    {% endif %}
    Predictors: {{ m.predictors | join(', ') | upper }} (global VIF &lt; 5 screen of
    {{ repro.bioclim_version_used }}, {{ repro.bioclim_source }}). Native-range polygon:
    {{ native_status }}.</p>
  {% set dq = repro.data_quality %}
  {% if dq %}
  <p><strong>Data quality.</strong> {{ dq.n_records | num }} records with climate data were
    tested ({{ dq.version }}{% if dq.reference %}, reference gazetteers {{ dq.reference.version }}{% endif %});
    {{ dq.n_excluded | num }} failed an excluding test and were left out of training
    ({% for t in dq.tests if t.excluded and t.status == 'run' and t.n_flagged %}{{ t.label | lower }} {{ t.n_flagged | num }}{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}),
    and {{ dq.n_flagged_kept | num }} carry review-only flags (isolated, climatically unusual or
    pre-baseline records may be genuine range edges).
    {% set skipped = dq.tests | selectattr('status', 'equalto', 'skipped') | list %}
    {% if skipped %}Not run: {% for t in skipped %}{{ t.label | lower }}{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
  {% endif %}
  {% if effort and effort.status == 'available' %}
  <p><strong>Sampling effort.</strong> {{ effort.candidate_unsampled_fraction | pct }} of the
    candidate invasion zone and {{ effort.land_unsampled_fraction | pct }} of all land hold no GBIF
    record of the target group, so the absence of presences there carries no information.</p>
  {% endif %}
  <p><strong>Severity index.</strong> {{ severity_footnote }}</p>
  <table class="compact">
    <tr><td>Bioclim version</td><td>{{ repro.bioclim_version_used }} (sha256 {{ (repro.bioclim_sha256 or 'n/a')[:12] }})</td></tr>
    <tr><td>GBIF download</td><td>{{ repro.gbif_download_doi or repro.gbif_download_key or 'search API (no DOI)' }}</td></tr>
    <tr><td>Packages</td><td>{% for k, v in repro.package_versions.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
    <tr><td>Random seeds</td><td>{% for k, v in repro.random_seeds.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
    {% if repro.data_quality and repro.data_quality.snapshot %}
    <tr><td>Quality flags</td><td>{{ repro.data_quality.snapshot.n_rows | num }} records (sha256 {{ repro.data_quality.snapshot.sha256[:12] }})</td></tr>
    {% endif %}
    <tr><td>MLflow run</td><td>{{ mv.mlflow_run_id or 'n/a' }}</td></tr>
  </table>
  <h3>References</h3>
  <ol class="refs">
    {% for r in references %}<li>{{ r }}</li>{% endfor %}
  </ol>
</section>

</body>
</html>
