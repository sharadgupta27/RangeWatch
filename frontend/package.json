{
  "name": "rangewatch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts",
    "gen:api:backend": "cd ../backend && python -m src.api.export_openapi ../frontend/openapi.json && cd ../frontend && npm run gen:api"
  },
